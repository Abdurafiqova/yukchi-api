generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum UserRole {
  CARGO_OWNER
  DRIVER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum OtpPurpose {
  LOGIN
  PHONE_CHANGE
}

enum VehicleType {
  TENT
  FLATBED
  REFRIGERATED
  TIPPER
  TANKER
  VAN
  ISOTHERMAL
  CONTAINER
  CAR_CARRIER
  CRANE
}

enum VehicleStatus {
  PENDING
  ACTIVE
  BLOCKED
}

enum VehicleDocumentType {
  TECH_PASSPORT
  INSURANCE
  TECH_INSPECTION
  PERMIT
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CargoStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
  EXPIRED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum NotificationType {
  CARGO_NEW
  OFFER_NEW
  OFFER_ACCEPTED
  OFFER_REJECTED
  MODERATION
  MESSAGE
  SYSTEM
}

enum ChatMessageKind {
  TEXT
  PHOTO
  LOCATION
}

enum ModerationAction {
  APPROVE
  REJECT
  BLOCK_USER
  UNBLOCK_USER
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  phone        String     @unique @db.VarChar(20)
  fullName     String?    @map("full_name") @db.VarChar(120)
  role         UserRole   @default(CARGO_OWNER)
  status       UserStatus @default(ACTIVE)
  avatarUrl    String?    @map("avatar_url") @db.Text
  companyName  String?    @map("company_name") @db.VarChar(160)
  language     String     @default("uz") @db.VarChar(5)
  rating       Decimal    @default(5) @db.Decimal(3, 2)
  ratingCount  Int        @default(0) @map("rating_count")
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  refreshTokens    RefreshToken[]
  otpCodes         OtpCode[]
  cargos           Cargo[]          @relation("CargoOwner")
  vehicles         Vehicle[]
  offers           Offer[]          @relation("DriverOffers")
  reviewsGiven     Review[]         @relation("ReviewAuthor")
  reviewsReceived  Review[]         @relation("ReviewTarget")
  notifications    Notification[]
  moderationLogs   ModerationLog[]  @relation("ModeratorLogs")
  documentReviews  VehicleDocument[] @relation("DocumentReviews")
  conversationsAsOwner  Conversation[]  @relation("OwnerConversations")
  conversationsAsDriver Conversation[]  @relation("DriverConversations")
  sentMessages     ChatMessage[]     @relation("SentMessages")

  @@index([role, status])
  @@index([deletedAt])
  @@map("users")
}

model OtpCode {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String?    @map("user_id") @db.Uuid
  phone       String     @db.VarChar(20)
  codeHash    String     @map("code_hash") @db.VarChar(128)
  purpose     OtpPurpose @default(LOGIN)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5) @map("max_attempts")
  expiresAt   DateTime   @map("expires_at")
  consumedAt  DateTime?  @map("consumed_at")
  ip          String?    @db.VarChar(64)
  createdAt   DateTime   @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, createdAt])
  @@index([expiresAt])
  @@map("otp_codes")
}

model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(128)
  userAgent   String?   @map("user_agent") @db.VarChar(255)
  ip          String?   @db.VarChar(64)
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  replacedBy  String?   @map("replaced_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model City {
  id        String   @id @db.VarChar(40)
  name      String   @db.VarChar(80)
  region    String?  @db.VarChar(80)
  lat       Decimal  @db.Decimal(9, 6)
  lng       Decimal  @db.Decimal(9, 6)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("cities")
}

model Cargo {
  id              String      @id @default(uuid()) @db.Uuid
  code            String      @unique @db.VarChar(16)
  ownerId         String      @map("owner_id") @db.Uuid
  title           String      @db.VarChar(160)
  description     String?     @db.Text
  cargoType       String      @map("cargo_type") @db.VarChar(80)
  weightKg        Int         @map("weight_kg")
  volumeM3        Decimal?    @map("volume_m3") @db.Decimal(8, 2)
  vehicleType     VehicleType @map("vehicle_type")
  price           Int         @db.Integer
  currency        String      @default("UZS") @db.VarChar(3)
  priceNegotiable Boolean     @default(false) @map("price_negotiable")
  paymentMethod   String      @default("CASH") @map("payment_method") @db.VarChar(16)
  advanceAmount   Int?        @map("advance_amount")
  trucksNeeded    Int         @default(1) @map("trucks_needed")
  isAdditionalLoad Boolean    @default(false) @map("is_additional_load")
  readyToLoad     Boolean     @default(true) @map("ready_to_load")
  status          CargoStatus @default(DRAFT)

  pickupCity      String    @map("pickup_city") @db.VarChar(80)
  pickupAddress   String?   @map("pickup_address") @db.VarChar(255)
  pickupPoint     Unsupported("geography(Point,4326)")? @map("pickup_point")
  dropoffCity     String    @map("dropoff_city") @db.VarChar(80)
  dropoffAddress  String?   @map("dropoff_address") @db.VarChar(255)
  dropoffPoint    Unsupported("geography(Point,4326)")? @map("dropoff_point")

  pickupDate      DateTime  @map("pickup_date")
  publishedAt     DateTime? @map("published_at")
  expiresAt       DateTime? @map("expires_at")
  viewCount       Int       @default(0) @map("view_count")
  offerCount      Int       @default(0) @map("offer_count")
  moderationNote  String?   @map("moderation_note") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  owner          User            @relation("CargoOwner", fields: [ownerId], references: [id])
  images         CargoImage[]
  offers         Offer[]
  conversations  Conversation[]
  moderationLogs ModerationLog[] @relation("CargoModerationLogs")

  @@index([status, publishedAt])
  @@index([status, expiresAt])
  @@index([ownerId, status])
  @@index([pickupCity])
  @@index([dropoffCity])
  @@index([vehicleType])
  @@index([deletedAt])
  @@index([pickupPoint], type: Gist)
  @@index([dropoffPoint], type: Gist)
  @@map("cargos")
}

model CargoImage {
  id        String  @id @default(uuid()) @db.Uuid
  cargoId   String  @map("cargo_id") @db.Uuid
  url       String  @db.Text
  alt       String? @db.VarChar(200)
  sortOrder Int     @default(0) @map("sort_order")

  cargo Cargo @relation(fields: [cargoId], references: [id], onDelete: Cascade)

  @@index([cargoId, sortOrder])
  @@map("cargo_images")
}

model Vehicle {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  plateNumber   String        @map("plate_number") @db.VarChar(20)
  vehicleType   VehicleType   @map("vehicle_type")
  capacityKg    Int           @map("capacity_kg")
  bodyVolumeM3  Decimal?      @map("body_volume_m3") @db.Decimal(8, 2)
  status        VehicleStatus @default(PENDING)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  driver    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  offers    Offer[]
  documents VehicleDocument[]

  @@unique([userId, plateNumber])
  @@index([vehicleType, status])
  @@map("vehicles")
}

model VehicleDocument {
  id           String              @id @default(uuid()) @db.Uuid
  vehicleId    String              @map("vehicle_id") @db.Uuid
  type         VehicleDocumentType
  status       DocumentStatus      @default(PENDING)
  filePath     String              @map("file_path") @db.Text
  fileMime     String              @map("file_mime") @db.VarChar(100)
  fileSize     Int                 @map("file_size")
  originalName String              @map("original_name") @db.VarChar(255)
  note         String?             @db.Text
  reviewedAt   DateTime?           @map("reviewed_at")
  reviewedById String?             @map("reviewed_by_id") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  vehicle    Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("DocumentReviews", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([vehicleId, type])
  @@index([status, createdAt])
  @@map("vehicle_documents")
}

model Offer {
  id         String      @id @default(uuid()) @db.Uuid
  cargoId    String      @map("cargo_id") @db.Uuid
  driverId   String      @map("driver_id") @db.Uuid
  vehicleId  String?     @map("vehicle_id") @db.Uuid
  price      Int         @db.Integer
  message    String?     @db.Text
  status     OfferStatus @default(PENDING)
  createdAt  DateTime    @default(now()) @map("created_at")
  respondedAt DateTime?  @map("responded_at")

  cargo   Cargo    @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  driver  User     @relation("DriverOffers", fields: [driverId], references: [id])
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@unique([cargoId, driverId])
  @@index([driverId, status])
  @@index([cargoId, status])
  @@map("offers")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  cargoId   String?  @map("cargo_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  targetId  String   @map("target_id") @db.Uuid
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  author User @relation("ReviewAuthor", fields: [authorId], references: [id])
  target User @relation("ReviewTarget", fields: [targetId], references: [id])

  @@unique([cargoId, authorId])
  @@index([targetId])
  @@map("reviews")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(160)
  body      String?          @db.Text
  payload   Json?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model ModerationLog {
  id          String           @id @default(uuid()) @db.Uuid
  cargoId     String?          @map("cargo_id") @db.Uuid
  moderatorId String           @map("moderator_id") @db.Uuid
  action      ModerationAction
  note        String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at")

  cargo     Cargo? @relation("CargoModerationLogs", fields: [cargoId], references: [id], onDelete: Cascade)
  moderator User   @relation("ModeratorLogs", fields: [moderatorId], references: [id])

  @@index([cargoId])
  @@index([moderatorId, createdAt])
  @@map("moderation_logs")
}

model Conversation {
  id            String    @id @default(uuid()) @db.Uuid
  cargoId       String    @map("cargo_id") @db.Uuid
  ownerId       String    @map("owner_id") @db.Uuid
  driverId      String    @map("driver_id") @db.Uuid
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  cargo    Cargo         @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  owner    User          @relation("OwnerConversations", fields: [ownerId], references: [id], onDelete: Cascade)
  driver   User          @relation("DriverConversations", fields: [driverId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@unique([cargoId, driverId])
  @@index([ownerId, lastMessageAt])
  @@index([driverId, lastMessageAt])
  @@map("conversations")
}

model ChatMessage {
  id             String          @id @default(uuid()) @db.Uuid
  conversationId String          @map("conversation_id") @db.Uuid
  senderId       String          @map("sender_id") @db.Uuid
  kind           ChatMessageKind @default(TEXT)
  text           String?         @db.Text
  readAt         DateTime?       @map("read_at")
  createdAt      DateTime        @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("chat_messages")
}
